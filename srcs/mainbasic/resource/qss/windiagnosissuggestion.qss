QWidget { background-color: transparent; color: rgb(250,250,252); }

QLabel { background: transparent; }

QPushButton { border-radius: 5px; }

QPushButton#btnLoad { background-color: rgb(48,48,48); border-radius: 5px; }

QTextBrowser { background-color: rgb(32,32,32); border: 1px solid rgb(80, 80, 80); padding: 5px; }

