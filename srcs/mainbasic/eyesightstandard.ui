   <property name="styleSheet">
    <string notr="true">QScrollArea { border-top: 1px solid rgb(35,46,50); border-bottom: 1px solid rgb(35,46,50); }

/* 整个滚动条区域样式 */
QScrollBar:vertical {  background: rgb(45, 56, 66); width: 30px; margin: 34px 0 34px 0; }
/* 滑块区域样式 */
QScrollBar::handle:vertical { border: 2px solid rgb(38, 47, 54); background: rgb(45, 56, 66); border-radius: 5px; }
/* 向上区域样式 */
QScrollBar::sub-line:vertical { border: 2px solid rgb(38, 47, 54); background: rgb(45, 56, 66); height: 30px; border-radius: 3px; subcontrol-position: top; subcontrol-origin: margin; }
/* 向下区域样式 */
QScrollBar::add-line:vertical { border: 2px solid rgb(38, 47, 54); background: rgb(45, 56, 66); height: 30px; border-radius: 3px; subcontrol-position: bottom; subcontrol-origin: margin; }
/* 向上箭头样式 */
QScrollBar::up-arrow:vertical { border: 1px solid rgb(45, 56, 66); width: 20px; height: 20px; background: solid rgb(45, 56, 66); 
  image:url(:/resource/black_theme/scrollbar-up-arrow_b.png); 
}
/* 向下箭头样式 */
QScrollBar::down-arrow:vertical { border: 1px solid rgb(45, 56, 66); width: 20px; height: 20px; background: solid rgb(45, 56, 66); 
  image:url(:/resource/black_theme/scrollbar-down-arrow_b.png); 
}
/* 滑块上面区域样式 */
QScrollBar::sub-page:vertical { background: rgb(32, 38, 42); border: 2px solid rgb(32, 38, 42); }
/* 滑块下面区域样式 */
QScrollBar::add-page:vertical { background: rgb(32, 38, 42); border: 2px solid rgb(32, 38, 42); }
</string>
   </property>
