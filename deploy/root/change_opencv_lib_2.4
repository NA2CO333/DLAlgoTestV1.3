#!/bin/bash -e
# change opencv lib to version 2.4

cd /root

gzip -dcvf /root/opencv_2.4.11.tar.gz > /root/opencv_2.4.11.tar

if [ -n "$(find /usr/lib -name 'libopencv_*' | head -1)" ]; then
	rm /usr/lib/libopencv_*
fi

cd /usr/lib

tar -xvf /root/opencv_2.4.11.tar

source /root/create_links_opencv_2.4

#ls -l /usr/lib/libopencv_*

cd


